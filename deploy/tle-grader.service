[Unit]
Description=TLE judge grader worker
After=network.target

[Service]
Type=simple
User=ray
Group=ray
WorkingDirectory=/opt/selfhost/tle
EnvironmentFile=/etc/tle/tle.env
ExecStart=/opt/selfhost/tle/tle_grader
Restart=on-failure
RestartSec=3
LimitNOFILE=4096
TasksMax=128
UMask=0007
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/selfhost/tle

[Install]
WantedBy=multi-user.target
