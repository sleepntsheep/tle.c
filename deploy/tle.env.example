# Copy to /etc/tle/tle.env and protect it with mode 0600.
TLE_PRODUCTION=1
TLE_BASE_URL=https://judge.example.com
# Caddy terminates TLS in the standard deployment; leave these empty.
TLE_TLS_CERT=
TLE_TLS_KEY=
TLE_ADMIN_PASSWORD=replace-with-a-long-random-secret
TLE_BACKUP_DIR=/var/backups/tle
TLE_BACKUP_KEEP=14
